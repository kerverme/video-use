# CLOUD VIDEO configuration. Copy to studio/.env (never commit the real file).
# Real environment variables override values in this file.

# --- AI edit planning (REQUIRED for "Generate Edit Plan") -------------------
# The web app plays the role video-use normally gives to the coding agent:
# it asks Claude to turn your instructions + footage analysis into a plan.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for planning (default: claude-opus-5)
# CLOUD_VIDEO_PLANNER_MODEL=claude-opus-5

# --- Transcription (OPTIONAL) ------------------------------------------------
# video-use transcribes speech with ElevenLabs Scribe (helpers/transcribe.py).
# Only useful for footage with speech; Blender renders are analyzed visually.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Access protection (set this before exposing the app to the internet) ---
# When set, the browser asks for this token once and keeps a session cookie.
CLOUD_VIDEO_ACCESS_TOKEN=

# --- Storage & uploads ---------------------------------------------------------
# Where projects live (default: <repo>/workspace). Point at a persistent volume.
# CLOUD_VIDEO_WORKSPACE=/data/workspace
# Max size per uploaded file in GB (default 50)
# CLOUD_VIDEO_MAX_UPLOAD_GB=50
# Upload chunk size in MB (default 8). Keep below any proxy body-size limit.
# CLOUD_VIDEO_CHUNK_MB=8
# Refuse uploads that would leave less than this much free disk (GB, default 2)
# CLOUD_VIDEO_MIN_FREE_GB=2
